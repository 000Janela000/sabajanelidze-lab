---
import { STEP } from '@lab/core'
import type { PaymentsBuildData } from './build-data.ts'
import { FIX, STEP_TEXT, TEXT_VERSION } from './texts.ts'

interface Props {
  data: PaymentsBuildData
}

const { data } = Astro.props
const { runs, losingLines, lossExample, v01Lines } = data
const percent = (part: number, whole: number) => `${Math.round((100 * part) / whole)}%`
const steps = v01Lines.flatMap((line) => (line.step ? [line.step] : []))
---

<div class="textv">
  <h2 id="text-version">{TEXT_VERSION.heading}</h2>

  <h3>{TEXT_VERSION.codeHeading}</h3>
  <p>{TEXT_VERSION.codeIntro}</p>
  <ol>
    {steps.map((step) => <li>{STEP_TEXT[step]}{step === STEP.READ_BALANCE ? TEXT_VERSION.checkSuffix : ''}</li>)}
  </ol>

  <h3>{TEXT_VERSION.reproduceHeading}</h3>
  <p>
    {TEXT_VERSION.reproduce(runs.naive.linesPerRequest, losingLines)}
    {lossExample ? TEXT_VERSION.loss(lossExample.paidOut, lossExample.available, Math.abs(lossExample.lost)) : ''}
  </p>

  <h3>{TEXT_VERSION.countHeading}</h3>
  <p>{TEXT_VERSION.count(runs.naive.runs, runs.naive.losing, percent(runs.naive.losing, runs.naive.runs))}</p>

  <h3>{TEXT_VERSION.fixHeading}</h3>
  <ul>
    <li>
      <strong>{FIX.patches.CHECK_TWICE.name}:</strong>{' '}
      {
        TEXT_VERSION.fix.checkTwice(
          runs.checkTwice.losing,
          runs.checkTwice.runs,
          percent(runs.checkTwice.losing, runs.checkTwice.runs),
        )
      }
    </li>
    <li>
      <strong>{FIX.patches.LOCK_READ.name}:</strong>{' '}
      {
        TEXT_VERSION.fix.lockRead(
          runs.lockRead.losing,
          runs.lockRead.runs,
          percent(runs.lockRead.losing, runs.lockRead.runs),
        )
      }
    </li>
    <li>
      <strong>{FIX.patches.RESERVE.name}:</strong>{' '}
      {TEXT_VERSION.fix.reserve(runs.reserve.losing, runs.reserve.runs)}
    </li>
  </ul>

  <h3>{TEXT_VERSION.cleanUpHeading}</h3>
  <p>{TEXT_VERSION.cleanUp}</p>
</div>

<style>
  .textv {
    max-width: 62em;
  }
  h2 {
    font-size: var(--fs-xl);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--weight-display);
  }
  h3 {
    margin-top: var(--space-5);
    font-size: var(--fs-md);
    font-weight: var(--weight-strong);
  }
  p,
  ol,
  ul {
    margin-top: var(--space-2);
    color: var(--muted);
  }
  strong {
    color: var(--fg);
  }
</style>
