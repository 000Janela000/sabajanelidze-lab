---
import { paymentsBuildData } from '../../incidents/payments/build-data.ts'
import { PaymentsIncident } from '../../incidents/payments/PaymentsIncident.tsx'
import ProofCard from '../../incidents/payments/ProofCard.astro'
import TextVersion from '../../incidents/payments/TextVersion.astro'
import { PAGE } from '../../incidents/payments/texts.ts'
import Base from '../../layouts/Base.astro'
import { bookACall } from '../../lib/links.ts'

const data = await paymentsBuildData()
const shareUrl = 'https://lab.sabajanelidze.com/day/payments'
---

<Base title={PAGE.title} description={PAGE.description} station="payments">
  <article>
    <p class="kicker">{PAGE.kicker}</p>
    <h1>{PAGE.heading}</h1>
    <blockquote class="ticket">
      <p>"{PAGE.ticket}"</p>
      <footer>{PAGE.ticketFrom}</footer>
    </blockquote>

    <PaymentsIncident
      client:visible
      v01={data.v01Lines}
      runs={data.runs.naive.runs}
      patches={data.patches}
      shareUrl={shareUrl}
      bookUrl={bookACall('payments')}
      proofId="proof"
    />

    <ProofCard id="proof" data={data} />
    <TextVersion data={data} />
  </article>
</Base>

<style>
  .kicker {
    margin: 24px 0 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  h1 {
    margin: 4px 0 12px;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
  }
  .ticket {
    margin: 0;
    padding: 12px 16px;
    border-left: 4px solid var(--lost);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .ticket p {
    margin: 0;
    font-size: 1.0625rem;
  }
  .ticket footer {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
