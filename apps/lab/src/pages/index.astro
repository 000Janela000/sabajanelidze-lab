---
import Base from '../layouts/Base.astro'
import { STATIONS } from '../lib/stations.ts'
import { HOME, STATION_NAME } from '../site-texts.ts'
---

<Base title={HOME.title} description={HOME.description} station="home">
  <section class="hero">
    <p class="kicker">{HOME.kicker}</p>
    <h1>{HOME.heading}</h1>
    <p class="lead">{HOME.lead}</p>
    <p class="start">
      <a class="button primary" href="/day/payments">{HOME.start}</a>
      <span class="start-note">{HOME.startNote}</span>
    </p>
  </section>

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">{HOME.howHeading}</h2>
    <ol class="how-steps">
      {
        HOME.how.map((item, index) => (
          <li>
            <span class="how-number">{index + 1}</span>
            <strong>{item.step}:</strong> {item.text}
          </li>
        ))
      }
    </ol>
    <p class="no-code">{HOME.noCode}</p>
  </section>

  <section aria-labelledby="day-heading">
    <h2 id="day-heading">{HOME.dayHeading}</h2>
    <ol class="incidents">
      {
        STATIONS.map((station, index) => (
          <li class:list={['incident-card', { soon: !station.ready }]}>
            <p class="meta">{HOME.incident(index + 1, station.time, STATION_NAME[station.slug] ?? station.slug)}</p>
            <p class="ticket">{HOME.tickets[station.slug]}</p>
            {station.ready ? (
              <a class="button primary" href={`/day/${station.slug}`}>
                {HOME.take}
              </a>
            ) : (
              <p class="soon-label">{HOME.comingSoon}</p>
            )}
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .hero {
    max-width: 68ch;
    padding: 32px 0 8px;
  }
  .kicker {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  h1 {
    margin: 8px 0 12px;
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.1;
  }
  .lead {
    margin: 0;
    font-size: 1.125rem;
  }
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }
  .start-note {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  h2 {
    margin-top: 40px;
    font-size: 1.25rem;
  }
  .how-steps {
    display: grid;
    gap: 8px;
    max-width: 68ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .how-number {
    display: inline-grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    margin-right: 6px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .no-code {
    max-width: 68ch;
    color: var(--text-muted);
  }
  .incidents {
    display: grid;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .incidents {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .incident-card {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .incident-card.soon {
    background: transparent;
  }
  .meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .ticket {
    margin: 0;
  }
  .soon-label {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .incident-card .button {
    justify-self: start;
  }
</style>
