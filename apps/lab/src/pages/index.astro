---
import Base from '../layouts/Base.astro'
import { STATIONS } from '../lib/stations.ts'
import { HOME, STATION_NAME } from '../site-texts.ts'
---

<Base title={HOME.title} description={HOME.description} station="home">
  <section class="sec">
    <div class="sec-in">
      <p class="margin">{HOME.margin}<small>{HOME.marginSub}</small></p>
      <div>
        <p class="kicker">{HOME.kicker}</p>
        <h1 class="h1">{HOME.heading}</h1>
        <p class="lead">{HOME.lead}</p>
        <p class="start">
          <a class="nb-btn" href="/day/payments">{HOME.start}</a>
          <span class="start-note nb-mono">{HOME.startNote}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="how-heading">
    <div class="sec-in">
      <p class="margin">{HOME.howMargin}<small>{HOME.howMarginSub}</small></p>
      <div>
        <h2 id="how-heading" class="h2">{HOME.howHeading}</h2>
        <ol class="how">
          {
            HOME.how.map((item, index) => (
              <li>
                <span class="num">{index + 1}</span>
                <span>
                  <b>{item.step}:</b> {item.text}
                </span>
              </li>
            ))
          }
        </ol>
        <p class="no-code">{HOME.noCode}</p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="day-heading">
    <div class="sec-in">
      <p class="margin">{HOME.dayMargin}<small>{HOME.dayMarginSub}</small></p>
      <div>
        <h2 id="day-heading" class="h2">{HOME.dayHeading}</h2>
        <ol class="incidents">
          {
            STATIONS.map((station, index) => (
              <li class:list={['card', { soon: !station.ready }]}>
                <p class="meta nb-mono">{HOME.incident(index + 1, station.time, STATION_NAME[station.slug] ?? station.slug)}</p>
                <p class="card-ticket">{HOME.tickets[station.slug]}</p>
                {station.ready ? (
                  <a class="nb-btn" href={`/day/${station.slug}`}>
                    {HOME.take}
                  </a>
                ) : (
                  <span class="nb-stamp">{HOME.comingSoon}</span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</Base>

<style>
  .lead {
    margin-top: var(--space-4);
    max-width: 40em;
    font-size: var(--fs-lg);
    line-height: 1.5;
  }
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .start-note {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .h2 {
    font-size: var(--fs-2xl);
    font-weight: var(--weight-strong);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .how {
    display: grid;
    gap: var(--space-3);
    max-width: 44em;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .how li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }
  .num {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-tag);
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    transform: translateY(0.2rem);
  }
  .no-code {
    max-width: 44em;
    margin-top: var(--space-4);
    color: var(--muted);
  }
  .incidents {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .incidents {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .card.soon {
    background: var(--surface-2);
  }
  .meta {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .card-ticket {
    font-size: var(--fs-md);
  }
</style>
