---
import { endStateHtml } from '@lab/race-figure/end-state'
import '@lab/race-figure/style.css'
import Maker from '../components/Maker.astro'
import Base from '../layouts/Base.astro'
import { STATIONS } from '../lib/stations.ts'
import { GAME_NAME, HOME, STATION_NAME, TEST_MODE } from '../site-texts.ts'

const playable = STATIONS.flatMap((station, index) => (station.ready ? [{ station, number: index + 1 }] : []))
---

<Base title={HOME.title} description={HOME.description} station="home">
  <section class="intro">
    <div class="intro-text">
      <p class="meta"><b class="game-name">{GAME_NAME}</b> · {HOME.meta} · <span class="nowrap">{TEST_MODE}</span></p>
      <h1 class="h1">{HOME.heading}</h1>
      <p class="lead">{HOME.lead}</p>
      <p class="start">
        <a class="btn" href="/day/payments">{HOME.start}</a>
        <span class="meta">{HOME.startNote}</span>
      </p>
      <Maker station="home" />
    </div>
    <race-figure class="console intro-figure" lab-url="/day/payments" set:html={endStateHtml('/day/payments')} />
  </section>

  <section class="section" aria-labelledby="how-heading">
    <h2 id="how-heading" class="h2">{HOME.howHeading}</h2>
    <ol class="how">
      {
        HOME.how.map((item, index) => (
          <li>
            <span class="num">{index + 1}</span>
            <span>
              <b>{item.step}:</b> {item.text}
            </span>
          </li>
        ))
      }
    </ol>
    <p class="no-code">{HOME.noCode}</p>
  </section>

  <section class="section" aria-labelledby="incidents-heading">
    <h2 id="incidents-heading" class="h2">{HOME.incidentsHeading}</h2>
    <ol class="incidents">
      {
        playable.map(({ station, number }) => (
          <li class="card">
            <p class="meta">{HOME.incident(number, STATION_NAME[station.slug] ?? station.slug)}</p>
            <p class="card-ticket">{HOME.tickets[station.slug]}</p>
            <a class="btn" href={`/day/${station.slug}`}>
              {HOME.take}
            </a>
          </li>
        ))
      }
    </ol>
    <p class="next">{HOME.next}</p>
  </section>
</Base>

<script>
  import '@lab/race-figure'
</script>

<style>
  .intro {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-7);
  }
  .intro-text {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }
  .intro .h1 {
    margin-top: var(--space-3);
  }
  /* The shared race figure, in the lab's dark console colours (the element styles its own card). */
  .intro-figure {
    align-self: start;
    background: none;
  }
  @media (min-width: 1024px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
      gap: var(--space-7);
    }
  }
  .lead {
    max-width: 40em;
    font-size: var(--fs-lg);
    line-height: 1.5;
  }
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .how {
    display: grid;
    gap: var(--space-3);
    max-width: 44em;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .how li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }
  .num {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    transform: translateY(0.15rem);
  }
  .no-code {
    max-width: 44em;
    margin-top: var(--space-4);
    color: var(--muted);
  }
  .incidents {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .incidents {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .next {
    max-width: 44em;
    margin-top: var(--space-5);
    color: var(--muted);
  }
  .card-ticket {
    font-size: var(--fs-md);
  }
</style>
