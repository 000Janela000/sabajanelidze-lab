---
import { STATIONS } from '../lib/stations.ts'
import { LAYOUT, STATION_NAME } from '../site-texts.ts'

interface Props {
  current: string
}

const { current } = Astro.props
---

<ol class="strip">
  {
    STATIONS.map((station) => (
      <li class:list={{ current: station.slug === current }}>
        {station.ready ? (
          <a href={`/day/${station.slug}`} aria-current={station.slug === current ? 'page' : undefined}>
            {station.time} {STATION_NAME[station.slug]}
          </a>
        ) : (
          <span>
            {station.time} {STATION_NAME[station.slug]} <em>{LAYOUT.soon}</em>
          </span>
        )}
      </li>
    ))
  }
</ol>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    color: var(--muted);
    white-space: nowrap;
  }
  .strip a {
    color: var(--fg);
    text-decoration: none;
  }
  .strip .current a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .strip em {
    font-style: normal;
    opacity: 0.8;
  }
</style>
