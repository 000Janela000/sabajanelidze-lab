---
import { STATIONS } from '../lib/stations.ts'
import { LAYOUT, STATION_NAME } from '../site-texts.ts'

interface Props {
  current: string
}

const { current } = Astro.props
---

<nav aria-label={LAYOUT.shiftLabel}>
  <ol class="strip">
    {
      STATIONS.map((station) => (
        <li class:list={[{ current: station.slug === current, soon: !station.ready }]}>
          {station.ready ? (
            <a href={`/day/${station.slug}`} aria-current={station.slug === current ? 'page' : undefined}>
              <span class="time">{station.time}</span> {STATION_NAME[station.slug] ?? station.slug}
            </a>
          ) : (
            <span>
              <span class="time">{station.time}</span> {STATION_NAME[station.slug] ?? station.slug} <em>{LAYOUT.soon}</em>
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .strip a {
    color: var(--text);
    text-decoration: none;
  }
  .strip .current a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .strip .soon {
    color: var(--text-muted);
  }
  .time {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }
  em {
    font-style: normal;
    font-size: 0.75rem;
  }
</style>
