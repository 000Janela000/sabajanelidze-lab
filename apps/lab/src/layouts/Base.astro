---
import '../styles/global.css'
import Fonts from '../components/Fonts.astro'
import ThemeSwitch from '../components/ThemeSwitch.astro'
import { bookACall, portfolio } from '../lib/links.ts'
import { LAYOUT } from '../site-texts.ts'

interface Props {
  title: string
  description: string
  station: string
  /** A page search engines should not list (the page for a missing address). */
  noindex?: boolean
}

const { title, description, station, noindex = false } = Astro.props
// The address the page is served at: without ".html" (the build writes day/payments.html, the Worker serves
// /day/payments) and without "index" (the home page is /).
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/(.)\/$/, '$1') || '/'
const canonical = new URL(path, Astro.site)
// The picture a link preview shows (chat apps, social sites): the home page's first screen, 1200 x 630.
const image = new URL('/og-image.png', Astro.site)

// Applies a saved Light/Dark choice before the first paint, the same as the portfolio (key "theme"; the old
// values "paper" and "blueprint" are read as light and dark). If storage is blocked, the system setting decides,
// as it does without JavaScript.
const themeBoot = `(function(){var d=document.documentElement;d.classList.add("js");try{var t=localStorage.getItem("theme");if(t==="paper")t="light";if(t==="blueprint")t="dark";if(t==="light"||t==="dark"){d.setAttribute("data-theme",t);var c=t==="light"?"#f7f5f0":"#15181d";document.querySelectorAll('meta[name="theme-color"]').forEach(function(m){m.setAttribute("content",c)})}}catch(e){}})();`

// Cloudflare Web Analytics (no cookies; the site "lab.sabajanelidze.com", made 2026-10-18; the token is public). It
// loads only on the live address, so the browser tests on this PC and in CI are never counted as visits.
const analytics = `if(location.hostname==="lab.sabajanelidze.com"){var s=document.createElement("script");s.defer=true;s.src="https://static.cloudflareinsights.com/beacon.min.js";s.setAttribute("data-cf-beacon",'{"token": "20d734c484b24e8dbb00dbcbfd4ec244"}');document.body.appendChild(s)}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15181d" media="(prefers-color-scheme: dark)" />
    <Fonts />
    <script is:inline set:html={themeBoot} />
  </head>
  <body>
    <a class="skip-link" href="#main">{LAYOUT.skip}</a>
    <header class="site-head">
      <div class="wrap site-head-in">
        <a class="brand" href="/">{LAYOUT.name} <span>· {LAYOUT.lab}</span></a>
        <a class="link head-book" href={bookACall(station)}>{LAYOUT.book}</a>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap site-foot-in">
        <div>
          <p>
            {LAYOUT.footerBefore} <a class="link" href={portfolio(station)}>{LAYOUT.footerName}</a>{LAYOUT.footerAfter}
          </p>
          <p>{LAYOUT.footerTestMode}</p>
        </div>
        <ThemeSwitch texts={LAYOUT.theme} />
      </div>
    </footer>
    <script is:inline set:html={analytics} />
  </body>
</html>
